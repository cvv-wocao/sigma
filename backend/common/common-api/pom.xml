<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.itcast.agent</groupId>
        <artifactId>backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-api</artifactId>
    <packaging>jar</packaging>

    <name>common-api</name>
    <description>服务间接口模块：Feign 客户端声明与请求/响应模型（本阶段仅占位）</description>

    <dependencies>
        <dependency>
            <groupId>cn.itcast.agent</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.itcast.agent</groupId>
            <artifactId>common-model</artifactId>
        </dependency>
        <!-- Jackson 注解：把 Gitee 的 snake_case 字段映射到 Java 驼峰字段（版本由 spring-boot-dependencies 管理） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- 服务间接口定义：Feign 客户端注解（spring-cloud-openfeign-core 只提供注解与契约，不含自动配置） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-openfeign-core</artifactId>
        </dependency>
        <!-- Feign 接口里的 @GetMapping / @RequestParam 等注解来自 spring-web -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
    </dependencies>
</project>