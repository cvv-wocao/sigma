# =====================================================================
# java-agent-platform 环境变量模板
# 使用方式：copy .env.example .env （Windows） / cp .env.example .env
# docker-compose.yml 会自动读取同目录下的 .env
#
# 注意：本文件是「Docker 编排」用的模板（宿主机端口、容器密码）。
#       后端服务在本机（IDEA / 命令行）启动时读的是 .env.local，见 README「配置管理」一节。
#       .env.local 已被 .gitignore 忽略，可以放心写本机密码。
# =====================================================================

# ===== 平台通用 =====
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=dev

# ===== MySQL（user-service） =====
# 说明：宿主机 3306 常被本机 MySQL 服务占用，容器默认映射到 3307
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=java_agent_platform
MYSQL_ROOT_PASSWORD=root
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# ===== Redis（ai-service 会话记忆） =====
REDIS_HOST=127.0.0.1
# 说明：宿主机 6379 常被本机 Redis 占用，容器默认映射到 6380
REDIS_PORT=6380
REDIS_PASSWORD=redis123

# ===== Nacos 注册中心 / 配置中心 =====
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP

# ===== Nginx =====
NGINX_HTTP_PORT=80

# ===== Spring AI：DeepSeek（ai-service） =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
# 用户自带 API Key 落库加密口令；生产环境请改为随机长字符串，修改后旧配置需重新保存
AI_MODEL_ENCRYPTION_KEY=local-dev-only-change-me

# ===== 平台模型计费（ai-service）=====
# 单价单位：元 / 百万 Token。普通用户使用平台 DeepSeek 时按实际输入/输出 Token 扣余额；
# 管理员免扣费；用户配置自己的 API Key 时不扣平台费。
AI_INPUT_PRICE_PER_MILLION_YUAN=2.0
AI_OUTPUT_PRICE_PER_MILLION_YUAN=8.0

# ===== 微信扫码充值（ai-service）=====
# 需要微信支付商户平台开通 Native 支付并绑定 APPID；notify-url 必须是公网 HTTPS。
# 商户私钥 apiclient_key.pem 与微信支付平台证书 platform_cert.pem 放到
# infrastructure/wechat-pay/ 下，容器只读挂载到 /run/secrets/wechat-pay/，不要提交到 Git。
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat-pay/apiclient_key.pem
WECHAT_PAY_PLATFORM_CERT_PATH=/run/secrets/wechat-pay/platform_cert.pem
WECHAT_PAY_NOTIFY_URL=https://你的域名/api/ai/wallet/wechat/notify
WECHAT_PAY_DESCRIPTION=AI 平台 Token 额度充值
WECHAT_PAY_EXPIRE_MINUTES=15

# ===== 支付宝当面付（ai-service）=====
# 推荐方案：预下单生成二维码，前端轮询 + 后端定时查单确认，不需要公网回调。
# 因此无需备案域名、HTTPS 回调地址或 443 端口；但支付宝开放平台应用仍需开通「当面付」。
# 应用私钥与支付宝公钥放到 infrastructure/alipay/，容器只读挂载到 /run/secrets/alipay/。
# 沙箱联调可把网关改为 https://openapi-sandbox.dl.alipaydev.com/gateway.do 。
ALIPAY_PAY_ENABLED=false
ALIPAY_PAY_APP_ID=
ALIPAY_PAY_PRIVATE_KEY_PATH=/run/secrets/alipay/app_private_key.pem
ALIPAY_PAY_PUBLIC_KEY_PATH=/run/secrets/alipay/alipay_public_key.pem
ALIPAY_PAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_PAY_SUBJECT=AI 平台 Token 额度充值
ALIPAY_PAY_EXPIRE_MINUTES=15
ALIPAY_PAY_RECONCILE_INTERVAL_MS=60000
ALIPAY_PAY_RECONCILE_INITIAL_DELAY_MS=30000

# ===== 长期记忆（ai-service）=====
# 记忆落库在 MySQL 的 ai_user_memory 表；默认走「关键词 + 重要度 + 时效」打分，开箱即用。
# 想让召回升级成语义检索，就把下面四项配齐（任意 OpenAI 兼容的 embeddings 接口都可以）：
#   硅基流动：MEMORY_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1   MODEL=BAAI/bge-m3
#   阿里云百炼兼容模式：BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   MODEL=text-embedding-v4
# 缺任意一项都会自动退回关键词打分，不影响对话可用性。
MEMORY_EMBEDDING_ENABLED=false
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=

# ===== Gitee（search-service）=====
# 仓库详情 / 分支列表免鉴权；关键词搜索必须有个人访问令牌，否则 Gitee 只返回空数组
# 获取：gitee.com -> 设置 -> 私人令牌
GITEE_BASE_URL=https://gitee.com
GITEE_ACCESS_TOKEN=

# ===== 监控（docker compose --profile monitoring） =====
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ===== 前端 =====
VITE_API_BASE_URL=/api

# ===== 检索来源（search-service）=====
# provider：主检索来源，github / gitee
SEARCH_PROVIDER=github
GITHUB_BASE_URL=https://api.github.com
# ZIP 归档下载使用的网页域名；GitHub Enterprise 可改成自己的站点地址
GITHUB_WEB_BASE_URL=https://github.com
# 可留空：留空时限流 10 次/分钟；配一个只读公开仓库的令牌可提到 30 次/分钟
GITHUB_TOKEN=
